<?xml version="1.0" encoding="UTF-8"?>
<config>
  <include path="subset150_main.xml" />
  <training>
    <epochs type="int">120</epochs>
    <batch_size type="int">4</batch_size>
    <gradient_accumulation_steps type="int">1</gradient_accumulation_steps>
    <drop_last type="bool">false</drop_last>
    <amp_dtype type="str">auto</amp_dtype>
    <minimum_epochs type="int">30</minimum_epochs>
    <min_delta type="float">0.0</min_delta>
    <validation_interval type="int">1</validation_interval>
    <early_stop_patience type="int">25</early_stop_patience>
    <prefetch_factor type="int">2</prefetch_factor>
    <non_blocking type="bool">true</non_blocking>
    <ema_enabled type="bool">true</ema_enabled>
    <ema_decay type="float">0.995</ema_decay>
    <ema_warmup_steps type="int">100</ema_warmup_steps>
    <best_weights type="str">ema</best_weights>
  </training>
  <optimizer>
    <kan_lr_multiplier type="float">0.5</kan_lr_multiplier>
    <kan_weight_decay type="float">0.000001</kan_weight_decay>
    <head_lr_multiplier type="float">1.0</head_lr_multiplier>
  </optimizer>
  <model>
    <name type="str">pa_hydrokan_v13</name>
    <channels type="list" item_type="int"><item>32</item><item>64</item><item>128</item><item>192</item></channels>
    <residual_block type="str">efficient</residual_block>
    <dropout type="float">0.10</dropout>
    <group_norm_groups type="int">8</group_norm_groups>
    <graph_scale type="int">8</graph_scale>
    <graph_heads type="int">4</graph_heads>
    <graph_message_normalization type="str">gate_sum</graph_message_normalization>
    <kan_grid_size type="int">8</kan_grid_size>
    <kan_spline_order type="int">3</kan_spline_order>
    <kan_edge_features type="int">12</kan_edge_features>
    <kan_input_normalization type="str">explicit_fixed_scaling</kan_input_normalization>
    <terrain_pixel_size_m type="float">20.0</terrain_pixel_size_m>
    <context_enabled type="bool">true</context_enabled>
    <deep_supervision_enabled type="bool">true</deep_supervision_enabled>
    <uncertainty_epsilon type="float">0.001</uncertainty_epsilon>
    <uncertainty_maximum type="float">5.0</uncertainty_maximum>
    <depth_output_semantics type="str">conditional_positive_v2</depth_output_semantics>
  </model>
  <loss>
    <depth_huber_beta_m type="float">0.25</depth_huber_beta_m>
    <log_depth_huber_beta type="float">0.25</log_depth_huber_beta>
    <gradient_huber_beta_m type="float">0.10</gradient_huber_beta_m>
    <lambda_gradient type="float">0.02</lambda_gradient>
    <gradient_start_epoch type="int">5</gradient_start_epoch>
    <gradient_warmup_epochs type="int">10</gradient_warmup_epochs>
    <pu_start_epoch type="int">5</pu_start_epoch>
    <pu_warmup_epochs type="int">10</pu_warmup_epochs>
    <unc_start_epoch type="int">8</unc_start_epoch>
    <unc_warmup_epochs type="int">10</unc_warmup_epochs>
    <lambda_auxiliary type="float">1.0</lambda_auxiliary>
    <auxiliary_start_epoch type="int">0</auxiliary_start_epoch>
    <auxiliary_warmup_epochs type="int">2</auxiliary_warmup_epochs>
    <auxiliary_depth_weights type="list" item_type="float"><item>0.10</item><item>0.20</item><item>0.0</item></auxiliary_depth_weights>
    <lambda_kan type="float">0.000001</lambda_kan>
    <kan_start_epoch type="int">0</kan_start_epoch>
    <kan_warmup_epochs type="int">0</kan_warmup_epochs>
  </loss>
</config>
