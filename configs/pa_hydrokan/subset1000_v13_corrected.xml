<?xml version="1.0" encoding="UTF-8"?>
<config>
  <include path="subset1000_v13_compact.xml" />
  <run_name type="str">pa_hydrokan_subset1000_hydrov13_1_candidate_corrected</run_name>
  <training>
    <epochs type="int">20</epochs><minimum_epochs type="int">15</minimum_epochs><early_stop_patience type="int">8</early_stop_patience>
    <!-- v13's legacy graph path is numerically unstable under AMP at batch=8 on
         this wider depth tail; retain a reproducible conservative baseline. -->
    <batch_size type="int">4</batch_size><amp type="bool">false</amp><num_workers type="int">4</num_workers><persistent_workers type="bool">true</persistent_workers>
  </training>
  <dataset><augmentation>
    <feature_dropout_probability type="float">0.05</feature_dropout_probability>
    <sensor_missing_simulation_probability type="float">0.05</sensor_missing_simulation_probability>
  </augmentation></dataset>
</config>
