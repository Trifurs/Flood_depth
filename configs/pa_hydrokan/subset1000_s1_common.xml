    <lambda_depth_exceedance type="float">0.0</lambda_depth_exceedance><lambda_pu type="float">0.0</lambda_pu><lambda_gradient type="float">0.0</lambda_gradient>
    <lambda_wse type="float">0.0</lambda_wse><lambda_absolute_laplacian type="float">0.0</lambda_absolute_laplacian><wse_mode type="str">v14_terrain_order</wse_mode><wse_start_epoch type="int">0</wse_start_epoch><wse_warmup_epochs type="int">0</wse_warmup_epochs>
    <lambda_auxiliary type="float">0.05</lambda_auxiliary><auxiliary_start_epoch type="int">0</auxiliary_start_epoch><auxiliary_warmup_epochs type="int">0</auxiliary_warmup_epochs><auxiliary_depth_weights type="list" item_type="float"><item>1.0</item></auxiliary_depth_weights>
    <lambda_unc type="float">0.01</lambda_unc><unc_start_epoch type="int">0</unc_start_epoch><unc_warmup_epochs type="int">0</unc_warmup_epochs><uncertainty_backprop_to_depth type="bool">false</uncertainty_backprop_to_depth>
    <lambda_kan type="float">0.000001</lambda_kan><kan_start_epoch type="int">0</kan_start_epoch><kan_warmup_epochs type="int">0</kan_warmup_epochs><lambda_kan_mono type="float">0.0</lambda_kan_mono><lambda_kan_smooth type="float">0.0</lambda_kan_smooth>
    <lambda_tail type="float">0.0</lambda_tail><tail_start_epoch type="int">0</tail_start_epoch><tail_warmup_epochs type="int">0</tail_warmup_epochs><tail_margin_m type="float">0.15</tail_margin_m><tail_huber_beta_m type="float">0.25</tail_huber_beta_m>
