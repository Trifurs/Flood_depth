  </optimizer>
  <scheduler><name type="str">cosine_with_warmup</name><warmup_epochs type="int">5</warmup_epochs><minimum_learning_rate type="float">0.000001</minimum_learning_rate></scheduler>
  <loss>
    <supervised_reduction type="str">pixel_micro</supervised_reduction>
    <depth_linear_loss type="str">smooth_l1</depth_linear_loss><depth_huber_beta_m type="float">1.0</depth_huber_beta_m><log_depth_huber_beta type="float">1.0</log_depth_huber_beta>
