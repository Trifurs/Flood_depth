    <terrain_pixel_size_m type="float">20.0</terrain_pixel_size_m><depth_order_tolerance_m type="float">0.02</depth_order_tolerance_m><terrain_order_huber_beta_m type="float">0.05</terrain_order_huber_beta_m><terrain_step_min_m type="float">0.02</terrain_step_min_m><terrain_step_max_m type="float">0.75</terrain_step_max_m><terrain_sigma_m type="float">0.75</terrain_sigma_m><terrain_relief_sigma_m type="float">12.0</terrain_relief_sigma_m>
    <schedule_total_epochs type="int">120</schedule_total_epochs><auxiliary_decay type="str">constant</auxiliary_decay>
  </loss>
</config>
