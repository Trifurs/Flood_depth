  </dataset>
  <run_name type="str">pa_hydrokan_subset1000_s1_common</run_name>
  <model>
    <name type="str">pa_hydrokan_s1_v14</name>
    <channels type="list" item_type="int"><item>32</item><item>64</item><item>128</item><item>192</item></channels>
    <residual_block type="str">efficient</residual_block>
    <dropout type="float">0.10</dropout>
    <group_norm_groups type="int">8</group_norm_groups>
    <terrain_pixel_size_m type="float">20.0</terrain_pixel_size_m>
