<?xml version="1.0" encoding="UTF-8"?>
<config>
  <include path="../base.xml" />
  <dataset>
    <name type="str">subset1000_s1_only</name>
    <root type="path">/home/whu/桌面/myData/Flood_depth/subset1000</root>
    <contract type="path">artifacts/dataset_audit/subset1000_contract.json</contract>
    <manifest type="path">/home/whu/桌面/myData/Flood_depth/subset1000/metadata/training_manifest.csv</manifest>
    <train_stats type="path">artifacts/dataset_audit/subset1000_train_stats.json</train_stats>
    <patch_size type="int">256</patch_size>
    <input_mode type="str">s1_terrain</input_mode>
    <continuous_groups type="list" item_type="str">
      <item>s1_t1</item><item>s1_t2</item><item>s1_change</item><item>terrain</item>
