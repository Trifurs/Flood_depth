<?xml version="1.0" encoding="UTF-8"?>
<!-- Frozen event-independent global-depth-bin Hydro-v11 experiment. -->
<config>
  <include path="../base.xml" />
  <include path="../datasets/flooddepth_subset150.xml" />
  <run_name type="str">pa_hydrokan_subset150_hydrov11_eventfree_depth_balance</run_name>
  <training>
    <best_metric type="str">pixel_micro_mae</best_metric>
  </training>
  <model>
    <name type="str">pa_hydrokan</name>
    <channels type="list" item_type="int">
      <item>32</item><item>64</item><item>128</item><item>256</item>
    </channels>
    <dropout type="float">0.10</dropout>
    <group_norm_groups type="int">8</group_norm_groups>
    <graph_scale type="int">8</graph_scale>
    <kan_grid_size type="int">8</kan_grid_size>
    <kan_spline_order type="int">3</kan_spline_order>
    <kan_edge_features type="int">8</kan_edge_features>
    <uncertainty_epsilon type="float">0.001</uncertainty_epsilon>
    <uncertainty_maximum type="float">20.0</uncertainty_maximum>
    <depth_output_semantics type="str">conditional_positive_v2</depth_output_semantics>
    <event_depth_scale_enabled type="bool">false</event_depth_scale_enabled>
    <event_depth_scale_hidden_channels type="int">64</event_depth_scale_hidden_channels>
    <event_depth_scale_max_log_abs type="float">0.6931471805599453</event_depth_scale_max_log_abs>
    <terrain_context_kernel_sizes type="list" item_type="int">
      <item>9</item>
    </terrain_context_kernel_sizes>
  </model>
  <loss>
    <supervised_reduction type="str">depth_bin_macro</supervised_reduction>
    <depth_linear_loss type="str">smooth_l1</depth_linear_loss>
    <depth_stratification_edges_m type="list" item_type="float">
      <item>0.10000000149011612</item>
      <item>0.23000000417232513</item>
      <item>0.47999998927116394</item>
      <item>0.8299999833106995</item>
      <item>1.2200000286102295</item>
      <item>2.140000104904175</item>
      <item>24.81999969482422</item>
    </depth_stratification_edges_m>
    <lambda_depth type="float">1.0</lambda_depth>
    <lambda_log type="float">0.5</lambda_log>
    <lambda_final type="float">0.0</lambda_final>
    <lambda_depth_bias type="float">0.0</lambda_depth_bias>
    <depth_bias_beta_m type="float">0.10</depth_bias_beta_m>
    <depth_underprediction_factor type="float">1.0</depth_underprediction_factor>
    <depth_underprediction_min_m type="float">0.48</depth_underprediction_min_m>
    <lambda_depth_exceedance type="float">0.0</lambda_depth_exceedance>
    <depth_exceedance_temperature_m type="float">0.10</depth_exceedance_temperature_m>
    <lambda_pu type="float">0.2</lambda_pu>
    <lambda_unc type="float">0.1</lambda_unc>
    <wse_mode type="str">absolute_laplacian</wse_mode>
    <lambda_wse type="float">0.02</lambda_wse>
    <wse_start_epoch type="int">5</wse_start_epoch>
    <wse_warmup_epochs type="int">15</wse_warmup_epochs>
    <wse_time_sigma type="float">0.25</wse_time_sigma>
    <wse_reference_sigma_m type="float">0.12</wse_reference_sigma_m>
    <wse_terrain_sigma_m type="float">0.75</wse_terrain_sigma_m>
    <wse_gradient_beta_m type="float">0.05</wse_gradient_beta_m>
    <terrain_order_min_step_m type="float">0.02</terrain_order_min_step_m>
    <terrain_order_max_step_m type="float">0.75</terrain_order_max_step_m>
    <terrain_order_beta_m type="float">0.02</terrain_order_beta_m>
  </loss>
</config>
