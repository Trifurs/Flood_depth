<?xml version="1.0" encoding="UTF-8"?>
<config>
  <!-- Inherit the exact v12 dataset, objective, optimizer, and pixel-first protocol. -->
  <include path="../pa_hydrokan/subset150_main.xml" />
  <model>
    <!-- Five scales correspond to the public DLSIM network choices. -->
    <channels type="list" item_type="int">
      <item>32</item><item>64</item><item>128</item><item>256</item><item>512</item>
    </channels>
    <dropout type="float">0.10</dropout>
    <group_norm_groups type="int">8</group_norm_groups>
    <input_adaptation type="str">learned_change_evidence_plus_slope_v1</input_adaptation>
    <depth_output_semantics type="str">conditional_positive_v2</depth_output_semantics>
  </model>
</config>
