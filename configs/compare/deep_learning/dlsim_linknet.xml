<config>
  <include path="../../base/base.xml" />
  <include path="../../base/datasets/flooddepthnet_s1_terrain.xml" />
  <run_name type="str">dlsim_linknet</run_name>
  <model>
    <name type="str">dlsim_linknet</name>
    <input_schema type="str">dlsim_change_dsm_range</input_schema>
    <input_channels type="int">5</input_channels>
    <flood_support type="str">valid_depth_mask</flood_support>
    <channels type="list" item_type="int"><item>24</item><item>48</item><item>96</item><item>144</item><item>192</item></channels>
    <depth_epsilon type="float">0.001</depth_epsilon>
    <uncertainty_scale_m type="float">0.35</uncertainty_scale_m>
    <depth_output_semantics type="str">conditional_positive</depth_output_semantics>
  </model>
  <loss>
    <depth_huber_beta_m type="float">0.50</depth_huber_beta_m>
    <lambda_log type="float">0.05</lambda_log>
  </loss>
</config>
