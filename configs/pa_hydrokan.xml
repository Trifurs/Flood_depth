<config>
  <include path="base/base.xml" />
  <include path="base/datasets/flooddepthnet_s1_terrain.xml" />
  <run_name type="str">pa_hydrokan</run_name>
  <training>
    <best_weights type="str">raw</best_weights>
    <ema_enabled type="bool">true</ema_enabled>
    <ema_decay type="float">0.9995</ema_decay>
    <ema_warmup_steps type="int">0</ema_warmup_steps>
  </training>
  <optimizer>
    <kan_lr_multiplier type="float">0.5</kan_lr_multiplier>
    <kan_weight_decay type="float">0.000001</kan_weight_decay>
    <head_lr_multiplier type="float">1.0</head_lr_multiplier>
  </optimizer>
  <inference>
    <nodata type="float">-9999.0</nodata>
    <save_geotiff type="bool">true</save_geotiff>
    <save_visualization type="bool">true</save_visualization>
  </inference>
  <model>
    <name type="str">pa_hydrokan</name>
    <display_name type="str">PA-HydroKAN</display_name>
    <formal_name type="str">Prior-Aware Hydrologic Kolmogorov-Arnold Network</formal_name>
    <channels type="list" item_type="int"><item>32</item><item>64</item><item>128</item><item>192</item></channels>
    <residual_block type="str">efficient</residual_block>
    <dropout type="float">0.10</dropout>
    <group_norm_groups type="int">8</group_norm_groups>
    <terrain_pixel_size_m type="float">20.0</terrain_pixel_size_m>
    <ground_proxy_kernel_size type="int">9</ground_proxy_kernel_size>
    <physics_elevation type="str">z_ground_proxy</physics_elevation>
    <terrain_mix_init type="float">0.05</terrain_mix_init>
    <terrain_alpha_max type="float">1.0</terrain_alpha_max>
    <reliability_conditioning_enabled type="bool">true</reliability_conditioning_enabled>
    <terrain_conditioned_fusion_enabled type="bool">true</terrain_conditioned_fusion_enabled>
    <topographic_affinity_enabled type="bool">true</topographic_affinity_enabled>
    <graph_feature_stride type="int">8</graph_feature_stride>
    <graph_heads type="int">2</graph_heads>
    <kan_grid_size type="int">4</kan_grid_size>
    <kan_spline_order type="int">3</kan_spline_order>
    <kan_gamma_init_effective type="float">0.06</kan_gamma_init_effective>
    <kan_gamma_max type="float">0.35</kan_gamma_max>
    <latent_compatibility_enabled type="bool">true</latent_compatibility_enabled>
    <graph_feature_centers type="list" item_type="float"><item>0.0</item><item>0.0</item><item>0.0</item><item>0.0</item><item>0.0</item><item>1.0</item></graph_feature_centers>
    <graph_feature_scales type="list" item_type="float"><item>0.10</item><item>0.10</item><item>1.0</item><item>1.0</item><item>1.0</item><item>0.5</item></graph_feature_scales>
    <decoder_widths type="list" item_type="int"><item>96</item><item>64</item><item>48</item><item>32</item></decoder_widths>
    <auxiliary_count type="int">1</auxiliary_count>
    <auxiliary_stage type="int">0</auxiliary_stage>
    <uncertainty_epsilon type="float">0.001</uncertainty_epsilon>
    <uncertainty_maximum type="float">5.0</uncertainty_maximum>
    <depth_output_semantics type="str">conditional_positive</depth_output_semantics>
    <depth_initialization_mode type="str">train_positive_median</depth_initialization_mode>
    <depth_initialization_bias type="float">-1.3047175317291613</depth_initialization_bias>
    <uncertainty_initial_scale_m type="float">0.35</uncertainty_initial_scale_m>
    <diagnostics_enabled type="bool">false</diagnostics_enabled>
  </model>
  <loss>
    <objective_mode type="str">task_adaptive</objective_mode>
    <supervised_reduction type="str">pixel_micro</supervised_reduction>
    <depth_linear_loss type="str">smooth_l1</depth_linear_loss>
    <depth_huber_beta_m type="float">0.50</depth_huber_beta_m>
    <log_depth_huber_beta type="float">0.50</log_depth_huber_beta>
    <lambda_depth type="float">1.0</lambda_depth>
    <lambda_log type="float">0.05</lambda_log>
    <lambda_final type="float">0.0</lambda_final>
    <lambda_depth_bias type="float">0.0</lambda_depth_bias>
    <depth_bias_beta_m type="float">0.1</depth_bias_beta_m>
    <lambda_depth_exceedance type="float">0.0</lambda_depth_exceedance>
    <depth_underprediction_factor type="float">1.0</depth_underprediction_factor>
    <depth_underprediction_min_m type="float">0.50</depth_underprediction_min_m>
    <tail_underprediction_alpha type="float">0.0</tail_underprediction_alpha>
    <lambda_gradient type="float">0.0</lambda_gradient>
    <lambda_auxiliary type="float">0.04</lambda_auxiliary>
    <auxiliary_start_epoch type="int">0</auxiliary_start_epoch>
    <auxiliary_warmup_epochs type="int">0</auxiliary_warmup_epochs>
    <auxiliary_huber_beta_m type="float">0.50</auxiliary_huber_beta_m>
    <auxiliary_depth_weights type="list" item_type="float"><item>1.0</item></auxiliary_depth_weights>
    <lambda_unc type="float">0.005</lambda_unc>
    <unc_start_epoch type="int">10</unc_start_epoch>
    <unc_warmup_epochs type="int">3</unc_warmup_epochs>
    <uncertainty_backprop_to_depth type="bool">false</uncertainty_backprop_to_depth>
    <lambda_kan type="float">0.000001</lambda_kan>
    <kan_start_epoch type="int">0</kan_start_epoch>
    <kan_warmup_epochs type="int">0</kan_warmup_epochs>
    <lambda_kan_mono type="float">0.0</lambda_kan_mono>
    <lambda_kan_smooth type="float">0.0</lambda_kan_smooth>
    <lambda_wse type="float">0.0</lambda_wse>
    <wse_mode type="str">terrain_order</wse_mode>
    <wse_start_epoch type="int">0</wse_start_epoch>
    <wse_warmup_epochs type="int">0</wse_warmup_epochs>
    <lambda_absolute_laplacian type="float">0.0</lambda_absolute_laplacian>
    <lambda_phys type="float">0.0</lambda_phys>
    <physics_mode type="str">terrain_order_margin</physics_mode>
    <phys_start_epoch type="int">15</phys_start_epoch>
    <phys_warmup_epochs type="int">10</phys_warmup_epochs>
    <physics_elevation_tolerance_m type="float">0.05</physics_elevation_tolerance_m>
    <physics_maximum_elevation_step_m type="float">0.75</physics_maximum_elevation_step_m>
    <physics_depth_tolerance_m type="float">0.02</physics_depth_tolerance_m>
    <physics_order_softplus_temperature_m type="float">0.05</physics_order_softplus_temperature_m>
    <physics_allowed_depth_jump_m type="float">0.25</physics_allowed_depth_jump_m>
    <physics_barrier_sigma_m type="float">0.75</physics_barrier_sigma_m>
    <physics_complexity_sigma_m type="float">12.0</physics_complexity_sigma_m>
    <physics_maximum_complexity_m type="float">12.0</physics_maximum_complexity_m>
    <physics_sar_compatibility_sigma type="float">1.0</physics_sar_compatibility_sigma>
    <lambda_tail type="float">0.0</lambda_tail>
    <tail_start_epoch type="int">0</tail_start_epoch>
    <tail_warmup_epochs type="int">0</tail_warmup_epochs>
    <tail_margin_m type="float">0.15</tail_margin_m>
    <tail_huber_beta_m type="float">0.25</tail_huber_beta_m>
    <soft_depth_balance type="bool">true</soft_depth_balance>
    <soft_depth_balance_alpha type="float">0.5</soft_depth_balance_alpha>
    <soft_depth_balance_tau type="float">10.0</soft_depth_balance_tau>
    <soft_depth_balance_minimum type="float">0.5</soft_depth_balance_minimum>
    <soft_depth_balance_maximum type="float">3.0</soft_depth_balance_maximum>
    <frozen_depth_weights_artifact type="path">artifacts/flooddepthnet_s1_terrain/frozen_depth_weights.json</frozen_depth_weights_artifact>
    <schedule_total_epochs type="int">200</schedule_total_epochs>
    <auxiliary_decay type="str">constant</auxiliary_decay>
  </loss>
</config>
