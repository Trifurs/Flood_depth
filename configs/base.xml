<config>
  <project_root type="path">.</project_root>
  <runs_root type="path">runs</runs_root>
  <artifacts_root type="path">artifacts</artifacts_root>
  <device type="str">auto</device>
  <seed type="int">20260904</seed>
  <deterministic type="bool">true</deterministic>
  <training>
    <epochs type="int">100</epochs>
    <minimum_epochs type="int">35</minimum_epochs>
    <batch_size type="int">12</batch_size>
    <gradient_accumulation_steps type="int">1</gradient_accumulation_steps>
    <num_workers type="int">4</num_workers>
    <persistent_workers type="bool">true</persistent_workers>
    <amp type="bool">true</amp>
    <amp_dtype type="str">bfloat16</amp_dtype>
    <grad_clip_norm type="float">1.0</grad_clip_norm>
    <early_stop_patience type="int">20</early_stop_patience>
    <best_metric type="str">pixel_micro_mae</best_metric>
    <best_weights type="str">raw</best_weights>
    <ema_enabled type="bool">true</ema_enabled>
    <ema_decay type="float">0.999</ema_decay>
    <ema_warmup_steps type="int">0</ema_warmup_steps>
  </training>
  <optimizer>
    <name type="str">adamw</name>
    <learning_rate type="float">0.00025</learning_rate>
    <weight_decay type="float">0.0001</weight_decay>
    <kan_lr_multiplier type="float">0.5</kan_lr_multiplier>
    <kan_weight_decay type="float">0.000001</kan_weight_decay>
    <head_lr_multiplier type="float">1.0</head_lr_multiplier>
  </optimizer>
  <scheduler>
    <name type="str">cosine_with_warmup</name>
    <warmup_epochs type="int">5</warmup_epochs>
    <minimum_learning_rate type="float">0.000001</minimum_learning_rate>
  </scheduler>
  <logging>
    <csv type="bool">true</csv>
    <tensorboard type="bool">true</tensorboard>
    <log_every_steps type="int">10</log_every_steps>
  </logging>
  <checkpoint>
    <save_last type="bool">true</save_last>
    <save_best type="bool">true</save_best>
    <strict_fingerprint type="bool">true</strict_fingerprint>
  </checkpoint>
  <inference>
    <nodata type="float">-9999.0</nodata>
    <save_geotiff type="bool">true</save_geotiff>
    <save_visualization type="bool">true</save_visualization>
  </inference>
</config>
